# ---- Runtime ----
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# ---- Database ----
# pglite (embedded PostgreSQL, dev/demo) | postgres (production)
DB_MODE=pglite
PGLITE_DIR=.data/pglite
DATABASE_URL=postgres://hms_app:CHANGE_ME@127.0.0.1:5432/hms
# Role assumed inside each transaction so RLS is enforced even if the connection user is privileged.
DB_SET_ROLE=hms_app

# ---- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ----
SESSION_SECRET=REPLACE_ME_32_BYTES_BASE64
ENCRYPTION_KEY=REPLACE_ME_32_BYTES_BASE64
SEARCH_HASH_KEY=REPLACE_ME_32_BYTES_BASE64

# ---- Sessions / security ----
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
COOKIE_SECURE=false

# ---- Demo ----
SEED_DEMO=true
